# Copy to .env and fill with real values:  cp .env.example .env
# NEVER commit .env with real secrets

# MySQL (Docker)
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=workforce_db
DB_USERNAME=root
# DB_PASSWORD defaults to MYSQL_ROOT_PASSWORD if not set

# Backend - use a long random string in production (min 32 chars)
DB_URL=jdbc:mysql://mysql-container:3306/workforce_db
JWT_SECRET=dev-only-change-me
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Spring profile
SPRING_PROFILES_ACTIVE=docker
